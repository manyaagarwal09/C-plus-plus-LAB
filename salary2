#include <iostream>
#include <iomanip>
using namespace std;

const int SIZE = 10;

class Person
{
    char name[64], address[64];
    int age;
    float basic, hra, da, ta, grossSalary;

public:
    Person()
    {
        name[0] = address[0] = '\0';
        age = 0;
        basic = hra = da = ta = grossSalary = 0;
    }

    Person(char n[], int a, char addr[], float b)
    {
        int i;

        for (i = 0; n[i] != '\0' && i < 63; i++)
            name[i] = n[i];
        name[i] = '\0';

        for (i = 0; addr[i] != '\0' && i < 63; i++)
            address[i] = addr[i];
        address[i] = '\0';

        age = a;
        basic = b;
        hra = 0.20f * basic;
        da = 0.50f * basic;
        ta = 1500.0f;
        grossSalary = basic + hra + da + ta;
    }

    void displaySalarySlip() const
    {
        cout << fixed << setprecision(2);

        cout << "\n========================================\n";
        cout << "              SALARY SLIP\n";
        cout << "========================================\n";

        cout << "Name    : " << name << endl;
        cout << "Age     : " << age << endl;
        cout << "Address : " << address << endl;

        cout << "----------------------------------------\n";
        cout << left << setw(25) << "EARNINGS"
             << right << setw(15) << "Amount" << endl;

        cout << left << setw(25) << "Basic Pay"
             << right << setw(15) << basic << endl;

        cout << left << setw(25) << "HRA (20%)"
             << right << setw(15) << hra << endl;

        cout << left << setw(25) << "DA (50%)"
             << right << setw(15) << da << endl;

        cout << left << setw(25) << "Travel Allowance"
             << right << setw(15) << ta << endl;

        cout << left << setw(25) << "Gross Salary"
             << right << setw(15) << grossSalary << endl;

        cout << "========================================\n";
    }
};

int main()
{
    Person p[SIZE];
    char name[64], address[64];
    int age;
    float basic;

    for (int i = 0; i < SIZE; i++)
    {
        cout << "\nEnter details of Person " << i + 1 << endl;

        cout << "Enter Name: ";
        cin.getline(name, 64);

        cout << "Enter Age: ";
        cin >> age;
        cin.ignore();

        cout << "Enter Address: ";
        cin.getline(address, 64);

        cout << "Enter Basic Salary: ";
        cin >> basic;
        cin.ignore();

        p[i] = Person(name, age, address, basic);
    }

    for (int i = 0; i < SIZE; i++)
        p[i].displaySalarySlip();

    return 0;
}
